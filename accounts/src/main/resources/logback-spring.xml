<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===================================== -->
    <!-- Import Exception Handling Starter defaults -->
    <!-- ===================================== -->
    <include resource="logback/exception-handling-defaults.xml"/>

    <!-- ===================================== -->
    <!-- CONSOLE: Simple format for application logs -->
    <!-- ===================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%15.15t] [%X{traceId}-%X{spanId}] %-40.40logger{39} : %m%n</pattern>
        </encoder>
    </appender>

    <!-- ===================================== -->
    <!-- Application-specific loggers -->
    <!-- ===================================== -->
    <logger name="com.nacionservicios.accounts" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="EXCEPTION_HANDLER_FILE"/>
    </logger>

    <!-- Hibernate SQL logs (optional) -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- ===================================== -->
    <!-- ROOT LOGGER -->
    <!-- ===================================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>